0:{"buildId":"Wf1r91nZHi-0DAOwEBdjc","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen","children":[["$","section",null,{"className":"max-w-5xl mx-auto px-4 sm:px-6 py-16","children":[["$","h1",null,{"className":"text-2xl sm:text-3xl font-bold text-[#78350f] mb-2 text-center","children":"心灵宫殿——六大内在结构"}],["$","p",null,{"className":"text-center text-[#78350f]/60 mb-10","children":"孩子内在世界的基本构成"}],["$","div",null,{"className":"bg-white rounded-xl border border-[#f59e0b]/10 p-6 mb-10","children":[["$","div",null,{"className":"text-center mb-6","children":["$","div",null,{"className":"inline-block px-4 py-2 bg-[#fef3c7] rounded-full text-sm font-medium text-[#78350f]","children":"心神（核心）"}]}],["$","div",null,{"className":"grid grid-cols-3 gap-4 text-center text-sm","children":[["$","div",null,{"className":"p-3 bg-[#f59e0b]/5 rounded-lg","children":[["$","p",null,{"className":"font-medium text-[#78350f] mb-1","children":"供能系统"}],["$","p",null,{"className":"text-[#78350f]/60","children":"准则价值与意义"}],["$","p",null,{"className":"text-[#78350f]/60","children":"情绪冲动与愿望"}]]}],["$","div",null,{"className":"p-3 bg-[#f59e0b]/5 rounded-lg","children":[["$","p",null,{"className":"font-medium text-[#78350f] mb-1","children":"保护系统"}],["$","p",null,{"className":"text-[#78350f]/60","children":"防御与妥协机制"}]]}],["$","div",null,{"className":"p-3 bg-[#f59e0b]/5 rounded-lg","children":[["$","p",null,{"className":"font-medium text-[#78350f] mb-1","children":"定向系统"}],["$","p",null,{"className":"text-[#78350f]/60","children":"自我意向"}],["$","p",null,{"className":"text-[#78350f]/60","children":"内化客体"}]]}]]}]]}],["$","div",null,{"className":"space-y-6","children":[["$","div","心神",{"className":"p-6 bg-white rounded-xl border border-[#f59e0b]/10","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-center gap-2 mb-3","children":[["$","h2",null,{"className":"text-lg font-semibold text-[#78350f]","children":"心神"}],["$","span",null,{"className":"text-xs px-2 py-0.5 bg-[#fef3c7] text-[#78350f] rounded-full","children":"核心"}],false]}],["$","p",null,{"className":"text-sm text-[#78350f]/70 leading-relaxed","children":"心神是统合一切的“主体感”，是觉知、专注、思考、抉择的中心。它不是某种具体的心理功能，而是那个让所有功能得以有序运转的“君王”。一个心神正、心神稳固的人，内在世界井然有序；一个心神涣散的人，即使拥有再多知识和技能，也如无源之水、无本之木，经不起风浪。内在结构养育最核心的任务，就是稳心神、固心神、让心神发光。"}]]}],["$","div","准则、价值与意义",{"className":"p-6 bg-white rounded-xl border border-[#f59e0b]/10","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-center gap-2 mb-3","children":[["$","h2",null,{"className":"text-lg font-semibold text-[#78350f]","children":"准则、价值与意义"}],["$","span",null,{"className":"text-xs px-2 py-0.5 bg-[#fef3c7] text-[#78350f] rounded-full","children":"指引系统"}],["$","span",null,{"className":"text-xs text-[#78350f]/50","children":"供能系统"}]]}],["$","p",null,{"className":"text-sm text-[#78350f]/70 leading-relaxed","children":"这是“什么是对”“什么重要”“我为何而活”的集合体。它为心神的决策提供依据，为生命提供超越当下快感的持久动力。一个拥有稳定价值准则的人，在人生岔路口不会迷失；而缺乏这一结构的人，可能在诱惑和压力面前随波逐流，或陷入“一切都没意义”的空虚。"}]]}],["$","div","情绪、冲动与愿望",{"className":"p-6 bg-white rounded-xl border border-[#f59e0b]/10","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-center gap-2 mb-3","children":[["$","h2",null,{"className":"text-lg font-semibold text-[#78350f]","children":"情绪、冲动与愿望"}],["$","span",null,{"className":"text-xs px-2 py-0.5 bg-[#fef3c7] text-[#78350f] rounded-full","children":"动力系统"}],["$","span",null,{"className":"text-xs text-[#78350f]/50","children":"供能系统"}]]}],["$","p",null,{"className":"text-sm text-[#78350f]/70 leading-relaxed","children":"这是生命的原生态能量——喜怒哀乐惧，以及饥渴、依恋、探索、攻击等本能冲动与心理愿望。这些能量是行动最原始的燃料。没有它们，生命就是一潭死水；但若没有心神的统合与其他系统的调节，这些能量可能变得肆虐伤人，或堵塞伤人于己。"}]]}],["$","div","防御与妥协机制",{"className":"p-6 bg-white rounded-xl border border-[#f59e0b]/10","children":[["$","div",null,{"className":"flex flex-col sm:flex-row sm:items-center gap-2 mb-3","children":[["$","h2",null,{"className":"text-lg font-semibold text-[#78350f]","children":"防御与妥协机制"}],["$","span",null,{"className":"text-xs px-2 py-0.5 bg-[#fef3c7] text-[#78350f] rounded-full","children":"保护与平衡系统"}],["$","span",null,{"className":"text-xs text-[#78350f]/50","children":"保护系统"}]]}],"$L2"]}],"$L3","$L4"]}]]}],"$L5","$L6","$L7"]}],null,"$L8"]}],"isPartial":"$@9","staleTime":"$a","varyParams":null},{"rsc":"$Lb","isPartial":"$@c","staleTime":"$a","varyParams":null},{"rsc":"$Ld","isPartial":"$@e","staleTime":"$a","varyParams":"$f"},{"rsc":"$L10","isPartial":"$@11","staleTime":"$a","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@12","rootVaryParams":null,"needsRuntimeRequest":"$@13"}
